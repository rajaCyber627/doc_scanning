{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docp.example/schemas/partner-payload-1.0.json",
  "title": "Capture Hub → Partner HRDMS document hand-off",
  "description": "Sent through PartnerAdapter.pushDocument when a captured document is ready (and again when it changes). Same documentId = update.",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "fileName",
    "mimeType",
    "sizeBytes",
    "capturedAt",
    "capturedBy",
    "metadata",
    "files",
    "index"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "documentId": {
      "type": "string",
      "description": "Capture Hub document id (stable)"
    },
    "partnerDocumentId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Partner id from a previous hand-off (null the first time)"
    },
    "fileName": {
      "type": "string"
    },
    "mimeType": {
      "type": "string"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "pageCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source": {
      "enum": [
        "upload",
        "camera",
        "scanner",
        "email",
        "import"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "capturedBy": {
      "type": "string"
    },
    "folderId": {
      "type": [
        "string",
        "null"
      ]
    },
    "batchId": {
      "type": [
        "string",
        "null"
      ]
    },
    "parentDocumentId": {
      "type": [
        "string",
        "null"
      ],
      "description": "The email or archive this document came from"
    },
    "confidentiality": {
      "type": [
        "string",
        "null"
      ],
      "description": "e.g. restricted (medical, FMLA, ADA, WC, ER) — the partner must apply its security matrix"
    },
    "metadata": {
      "type": "object",
      "description": "Standard HR metadata (employee, document type, dates, …) — see P09"
    },
    "files": {
      "type": "object",
      "required": [
        "original"
      ],
      "additionalProperties": false,
      "properties": {
        "original": {
          "$ref": "#/$defs/storedFile"
        },
        "searchablePdf": {
          "oneOf": [
            {
              "$ref": "#/$defs/storedFile"
            },
            {
              "type": "null"
            }
          ]
        },
        "fullText": {
          "oneOf": [
            {
              "$ref": "#/$defs/storedFile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the text is longer than index.text"
        }
      }
    },
    "index": {
      "type": "object",
      "required": [
        "language",
        "text",
        "textTruncated",
        "pages"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "description": "ISO 639-1 (en, es) or und"
        },
        "text": {
          "type": "string",
          "description": "Normalized full text for indexing"
        },
        "textTruncated": {
          "type": "boolean"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "page",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "ocr": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "provider",
            "averageConfidence",
            "formFields"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "averageConfidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "formFields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "page": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "reviewedAt",
            "reviewedBy",
            "resolvedReasons"
          ],
          "additionalProperties": false,
          "properties": {
            "reviewedAt": {
              "type": "string",
              "format": "date-time"
            },
            "reviewedBy": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolvedReasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "supersedesDocumentId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when this document replaces an earlier one (\"Replace existing\" duplicate decision): the partner should treat it as a new version"
    }
  },
  "$defs": {
    "storedFile": {
      "type": "object",
      "required": [
        "s3Key",
        "contentType"
      ],
      "additionalProperties": false,
      "properties": {
        "s3Key": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        }
      }
    }
  }
}
