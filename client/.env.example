# client/.env.example — copy to client/.env and adjust. Only REACT_APP_* variables reach the app
# (VITE_* names are ignored by react-scripts). Restart `npm start` after edits.

# Backend origin for API calls. Request paths already start with /api, so leave
# /api off the end. Blank = same origin (the backend serves the built UI).
REACT_APP_API_BASE_URL=http://localhost:9000

# Port the dev server (`npm start`) listens on. Must match CORS_ORIGIN in backend/.env.
PORT=5173
